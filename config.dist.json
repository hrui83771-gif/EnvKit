      "zip_top": "mysql-8.0.44-winx64",
      "bin_rel": "bin",
      "bin_exe": "mysqld.exe",
      "check_cmd": "mysqld",
      "check_args": [
        "--version"
      ],
      "check_regex": "8\\.0",
      "special": "mysql",
      "extra_env": null
    }
  ],
