      "zip_top": "node-v24.22.3-win-x64",
      "bin_rel": "",
      "bin_exe": "node.exe",
      "check_cmd": "node",
      "check_args": [
        "--version"
      ],
      "check_regex": "v2",
      "special": "",
      "extra_env": null,
      "sha256": "e612af99f626ab415ea225af6bce5c971feb448cb5cae250bb1c3fa50c5f7d9f"
    },
    {
      "name": "MySQL",
      "version": "8.0.44",
