      "zip_top": "node-v22.22.0-win-x64",
      "bin_rel": "",
      "bin_exe": "node.exe",
      "check_cmd": "node",
      "check_args": [
        "--version"
      ],
      "check_regex": "v2",
      "special": "",
      "extra_env": null,
      "sha256": "c97fa376d2becdc8863fcd3ca2dd9a83a9f3468ee7ccf7a6d076ec66a645c77a"
    },
    {
      "name": "MySQL",
      "version": "8.0.44",
